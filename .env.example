# Copy to .env (do NOT commit). For local dev:
#   cd apps/web && bun run dev

# Postgres — Neon free tier or any Postgres URL.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/code_arena?sslmode=require

# Better Auth — generate a 32+ byte random secret:  openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-random-string

# Public URL of this app. Local dev: http://localhost:3000
# Production: https://code-arena.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client ID).
# Authorized redirect URI must be:
#   http://localhost:3000/api/auth/callback/google      (dev)
#   https://code-arena.onrender.com/api/auth/callback/google  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: set to 1 to disable scheduler + match runner (e.g. CI builds).
# DISABLE_BACKGROUND=1
