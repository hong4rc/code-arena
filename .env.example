# Copy to .env (do NOT commit .env). For local dev:
#   cd apps/web && bun run dev

# Supabase Postgres — use direct URL for migrations, pooler URL for runtime.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase auth (Google OAuth must be enabled in Supabase Auth → Providers).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# Optional: set to 1 to disable scheduler + match runner (e.g. CI builds).
# DISABLE_BACKGROUND=1
